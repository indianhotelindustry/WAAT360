# WAAST360 Bridge Configuration Template
#
# Copy this file to .env and configure for your environment.
# DO NOT commit .env to version control.
# DO NOT include production credentials in this template.

# Deployment Mode: 'development' or 'production'
# - development: allows HTTP, test credentials, simulated adapter
# - production: requires HTTPS, valid credentials, real Tally connection
BRIDGE_ENV=development

# WAAST360 Cloud API URL
# - Development: http://localhost:8000 (local testing)
# - Production: https://your-waast360-cloud.example.com (MUST be HTTPS)
CLOUD_URL=http://127.0.0.1:8000

# Bridge Client Identifier (assigned by WAAST360 admin)
# Uniquely identifies this Bridge instance to the Cloud API
BRIDGE_CLIENT_ID=BR-LOCAL-01

# API Key for Cloud Authentication
# SECURITY: Never commit this file with a real key.
# For production: Provide via Windows Credential Manager or environment variable.
# For development: Use test key below (safe for local testing only).
BRIDGE_API_KEY=test-bridge-secret-key

# Tally Runtime Connection
# Host: typically 127.0.0.1 (loopback) when Bridge is on same machine as Tally
# Port: 9000 (default TallyPrime HTTP/ODBC server port)
TALLY_HOST=127.0.0.1
TALLY_PORT=9000

# Bridge Polling Intervals (seconds)
# POLL_INTERVAL_SECONDS: How often Bridge checks Cloud for new jobs (default 5s)
# HEARTBEAT_INTERVAL_SECONDS: How often Bridge sends health status (default 15s)
POLL_INTERVAL_SECONDS=5.0
HEARTBEAT_INTERVAL_SECONDS=15.0

# Local SQLite Database Path (optional)
# If empty, uses: C:\Users\{username}\.waast360\bridge\bridge_store.db
# Override to use a custom location (must be writable).
DB_PATH=

# Adapter Preference
# true: Prefer JSON (TallyPrime 7.0+)
# false: Force XML (compatibility mode)
PREFER_JSON=true
